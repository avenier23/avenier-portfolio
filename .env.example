# Copy this file to .env and fill in the values. Never commit .env.

# The chat uses free built-in answers by default (src/data/assistant.js).
# To switch to the Claude-powered AI assistant, set both of these (API usage is billed by Anthropic):
VITE_AI_ENABLED=false
ANTHROPIC_API_KEY=

# Optional: deliver booking requests straight to your inbox. Free key at https://web3forms.com
# Without it, the booking form opens a pre-filled email instead.
VITE_WEB3FORMS_KEY=
